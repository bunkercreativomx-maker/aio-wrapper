{
    "name": "wrapper-one",
    "version": "1.3.0",
    "description": "WrapperOne - All-in-One Web Workspace",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder"
    },
    "keywords": [
        "electron",
        "web-wrapper"
    ],
    "author": "pakov",
    "license": "ISC",
    "devDependencies": {
        "electron": "^44.0.0",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "electron-log": "^5.4.4",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.8.9",
        "firebase": "^12.10.0"
    },
    "build": {
        "appId": "com.pakov.wrapperone",
        "productName": "WrapperOne",
        "asar": false,
        "win": {
            "target": "nsis",
            "icon": "icon.ico",
            "artifactName": "WrapperOne-Setup-${version}.${ext}"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Network",
            "icon": "build/icon.png",
            "maintainer": "pakov",
            "artifactName": "WrapperOne-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "directories": {
            "output": "dist"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "bunkercreativomx-maker",
                "repo": "aio-wrapper"
            }
        ]
    }
}
